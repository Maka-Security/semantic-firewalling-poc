{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Semantic Firewall Registry",
  "description": "Defines sensors and the facts each is contractually permitted to emit.",
  "type": "object",
  "required": ["sensors"],
  "additionalProperties": false,
  "properties": {
    "sensors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "allowed_facts"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Unique sensor identifier (snake_case)."
          },
          "allowed_facts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "Fact key (snake_case). Must not contain forbidden semantic tokens."
            }
          }
        }
      }
    }
  }
}
